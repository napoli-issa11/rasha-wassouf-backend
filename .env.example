APP_NAME="Rasha Wassouf Architecture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rasha_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# On Render cloud (single web service container), use sync so emails dispatch immediately:
QUEUE_CONNECTION=sync
QUEUE_WORKER_ACTIVE=false

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================================
# MAIL CONFIGURATION (RENDER PRODUCTION & LOCAL ENVIRONMENTS)
# Mailtrap SMTP Live Delivery Configuration
# =========================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=your_mailtrap_api_key_or_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@rashawassouf.com
MAIL_FROM_NAME="Rasha Wassouf Architecture"
MAIL_TIMEOUT=15
ADMIN_EMAIL=support@rashawassouf.com

# --- ALTERNATIVE MAIL PROVIDERS ---
# Resend API:
# MAIL_MAILER=resend
# RESEND_API_KEY=re_1234567890abcdef

# Brevo / Sendinblue (Port 587):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-brevo-login@example.com
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_ENCRYPTION=tls

# Google Gmail SMTP (Port 465 SSL):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=your-app-password


# Cloudinary Cloud Storage (For 100MB Limited Storage Hosting)
# Option 1: Complete Cloudinary URL (Copied directly from Cloudinary Console Dashboard)
CLOUDINARY_URL=

# Option 2: Individual API Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true

VITE_APP_NAME="${APP_NAME}"
