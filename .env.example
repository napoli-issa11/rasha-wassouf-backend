APP_NAME="Rasha Wassouf Architecture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rasha_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# On Render cloud (single web service container), use sync so emails dispatch immediately:
QUEUE_CONNECTION=sync
QUEUE_WORKER_ACTIVE=false

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================================
# MAIL CONFIGURATION (CRITICAL FOR RENDER PRODUCTION HOSTING)
# =========================================================================
# NOTE: Render blocks outbound port 25. NEVER use port 25 on Render.
# Default sender & admin destination:
MAIL_FROM_ADDRESS="studio@rashawassouf.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL="director@rashawassouf.com"
MAIL_TIMEOUT=15

# --- OPTION 1: Resend (RECOMMENDED FOR RENDER - HTTPS API, NO PORT BLOCKING) ---
# MAIL_MAILER=resend
# RESEND_API_KEY=re_1234567890abcdef

# --- OPTION 2: Brevo / Sendinblue (Free 300 emails/day, SMTP Port 587) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=your-brevo-login-email@example.com
# MAIL_PASSWORD=your-brevo-master-smtp-key

# --- OPTION 3: SendGrid (SMTP Port 587) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# --- OPTION 4: Google Gmail SMTP (Port 465 with 16-character App Password) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=abcd-efgh-ijkl-mnop
# MAIL_FROM_ADDRESS=your-gmail@gmail.com

# --- OPTION 5: Local Testing / Log Driver (Emails written to storage/logs/laravel.log) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Cloudinary Cloud Storage (For 100MB Limited Storage Hosting)
# Option 1: Complete Cloudinary URL (Copied directly from Cloudinary Console Dashboard)
CLOUDINARY_URL=

# Option 2: Individual API Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true

VITE_APP_NAME="${APP_NAME}"
